{
  "name": "venom-board",
  "productName": "Venom Board",
  "version": "1.3.0",
  "description": "The reference board and roadmap planner for game developers: infinite canvas, dependency-aware task cards, milestones, live team projects and an always-on-top overlay mode.",
  "author": "1337VIPER",
  "license": "MIT",
  "homepage": "https://github.com/1337VIPER/venom-board",
  "repository": {
    "type": "git",
    "url": "https://github.com/1337VIPER/venom-board.git"
  },
  "bugs": {
    "url": "https://github.com/1337VIPER/venom-board/issues"
  },
  "keywords": [
    "gamedev",
    "game-development",
    "roadmap",
    "project-planning",
    "reference-board",
    "moodboard",
    "pureref",
    "kanban",
    "electron"
  ],
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never && node tools/sign-update.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.venomboard.app",
    "productName": "Venom Board",
    "copyright": "Copyright (c) 2026 1337VIPER",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "electron/**/*",
      "!electron/dev{,/**/*}",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/icon-1024.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "VenomBoard"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "VenomBoard-Setup-${version}.${ext}",
      "shortcutName": "Venom Board",
      "uninstallDisplayName": "Venom Board",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-1024.png",
      "category": "Graphics",
      "executableName": "venom-board",
      "artifactName": "VenomBoard-${version}.${ext}",
      "synopsis": "Reference board and roadmap planner for game developers",
      "description": "The reference board and roadmap planner for game developers: infinite canvas, dependency-aware task cards, milestones, live team projects and an always-on-top overlay mode."
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon-1024.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "VenomBoard-${version}-mac.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "1337VIPER",
        "repo": "venom-board"
      }
    ]
  }
}
