# Venom Board server settings. Copy this file to .env in this folder and fill it in.
# Lines starting with # are ignored. Anything left out uses the default shown.

# ---- Where it's reached ------------------------------------------------------------------------------------
# With docker compose: the domain (or subdomain) pointing at this machine. Caddy gets its HTTPS certificate,
# and the server's address becomes https://DOMAIN.
DOMAIN=boards.example.com

# Without docker compose: the address people open, with https://, and where the Node server listens.
# Keep HOST=127.0.0.1 behind a reverse proxy on the same machine, and set TRUST_PROXY=true only when that proxy
# sets X-Real-IP to the visitor's address.
# PUBLIC_URL=https://boards.example.com
# HOST=127.0.0.1
# PORT=8787
# TRUST_PROXY=false

# The database and uploaded pictures (docker compose keeps them in a volume instead). Back this folder up.
# DATA_DIR=./server/data

# ---- Email ---------------------------------------------------------------------------------------------------
# Used for confirming addresses, password resets and invites by email. Any mailbox that offers SMTP works;
# use port 587 (STARTTLS) or 465 (TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Venom Board <boards@example.com>
MAIL_REPLY_TO=

# Or send through resend.com: leave SMTP_HOST empty and set a key here.
RESEND_API_KEY=

# No email at all? Accounts can't confirm their address, so they keep the lower limits for unconfirmed accounts
# (see below), and forgotten passwords can't be reset. MAIL_LOG=on writes each email, links included, to the
# server's log instead (docker compose logs venom-board), so whoever runs the server can pass them on.
MAIL_LOG=off

# Shown in a few messages as the address to write to when something's urgent (defaults to MAIL_REPLY_TO).
SUPPORT_EMAIL=

# ---- Limits --------------------------------------------------------------------------------------------------
# How long a sign-in lasts without being used, in days.
# SESSION_DAYS=30
# Teams one account can lead and be in, projects per team, people per team (members plus waiting invites).
# LIMIT_TEAMS_LED=10
# LIMIT_TEAMS_JOINED=30
# LIMIT_TEAM_PROJECTS=100
# LIMIT_TEAM_MEMBERS=50
# One project's board, not counting pictures; storage per team and across the teams one person leads (MB).
# PROJECT_MAX_MB=10
# TEAM_STORAGE_MB=500
# LEADER_STORAGE_MB=1024
# Until an account confirms its email: teams it can lead, projects it can make, storage (MB).
# LIMIT_UNVERIFIED_TEAMS=1
# LIMIT_UNVERIFIED_PROJECTS=10
# LIMIT_UNVERIFIED_STORAGE_MB=100
# Video files in team projects (YouTube and Vimeo links always work), and their size in MB.
# VIDEO_UPLOADS=off
# VIDEO_MAX_MB=25
# Uploads stop before the disk gets this full, and ALERT_EMAIL hears about it well before (MB).
# MIN_FREE_DISK_MB=2048
# ALERT_FREE_DISK_MB=6144
# ALERT_EMAIL=
# Emails per day and per 10 minutes, so a mailbox's own limits aren't reached.
# MAIL_DAILY_LIMIT=800
# MAIL_PER_10_MIN=40
